# =============================================================================
# CyberSecurityAIAgent - environment configuration
# Copy this file to `config/.env` and fill in the values you have:
#     cp config/.env.example config/.env
# The dotenv file is loaded from the config/ folder.
# The system runs in a fully offline, deterministic "fallback" mode when no
# keys are provided, and automatically upgrades to live LLM / web search when
# the relevant keys are present.
# =============================================================================

# ---- LLM provider key. If unset, the deterministic fallback LLM is used. ----
# Works with OpenAI keys (sk-...) and OpenRouter keys (sk-or-...).
OPENAI_API_KEY=

# OpenAI-compatible base URL for the chat LLM. This is the single source of
# truth for the endpoint (no provider URL is hard-coded in the code).
# Default targets OpenRouter; set to blank for the OpenAI API, or to an Azure /
# local gateway URL as needed.
CSAI_LLM_BASE_URL=https://openrouter.ai/api/v1

# Chat model id, as expected by the configured base URL.
# OpenRouter expects a namespaced id (e.g. openai/gpt-4o-mini);
# the OpenAI API expects a bare id (e.g. gpt-4o-mini).
CSAI_LLM_MODEL=openai/gpt-4o-mini

# Embedding model used for RAG. If OpenAI embeddings are unavailable (no key, or
# a provider without an embeddings endpoint such as OpenRouter), a local hashing
# embedding is used instead so FAISS still works.
CSAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Web search (Tavily). If unset, a local threat-intel corpus is used. ----
TAVILY_API_KEY=

# ---- ServiceNow CMDB (optional). Used by the bulk scanner to resolve all
# database servers mapped to an Application Instance. If any value is unset, a
# bundled offline CMDB fixture (data/cmdb/cmdb.json) is used instead. ----
SNOW_INSTANCE_URL=
SNOW_USERNAME=
SNOW_PASSWORD=

# ---- Behaviour flags ----
# Force offline mode even if keys are present (useful for deterministic evals).
CSAI_OFFLINE=false
# LLM sampling temperature.
CSAI_TEMPERATURE=0.1
# Directory that holds the FAISS index + knowledge base cache.
CSAI_INDEX_DIR=.cache/faiss_index
# Logging level: DEBUG, INFO, WARNING, ERROR
CSAI_LOG_LEVEL=INFO
