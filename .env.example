# =============================================================================
# CyberSecurityAIAgent - environment configuration
# Copy this file to `.env` and fill in the values you have.
# The system runs in a fully offline, deterministic "fallback" mode when no
# keys are provided, and automatically upgrades to live LLM / web search when
# the relevant keys are present.
# =============================================================================

# ---- LLM provider (OpenAI). If unset, deterministic fallback LLM is used. ----
OPENAI_API_KEY=
# Chat model used for agent reasoning / summarisation.
CSAI_LLM_MODEL=gpt-4o-mini
# Embedding model used for RAG. If OPENAI_API_KEY is unset, a local hashing
# embedding is used instead so FAISS still works offline.
CSAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Web search (Tavily). If unset, a local threat-intel corpus is used. ----
TAVILY_API_KEY=

# ---- ServiceNow CMDB (optional). Used by the bulk scanner to resolve all
# database servers mapped to an Application Instance. If any value is unset, a
# bundled offline CMDB fixture (data/cmdb/cmdb.json) is used instead. ----
SNOW_INSTANCE_URL=
SNOW_USERNAME=
SNOW_PASSWORD=

# ---- Behaviour flags ----
# Force offline mode even if keys are present (useful for deterministic evals).
CSAI_OFFLINE=false
# LLM sampling temperature.
CSAI_TEMPERATURE=0.1
# Directory that holds the FAISS index + knowledge base cache.
CSAI_INDEX_DIR=.cache/faiss_index
# Logging level: DEBUG, INFO, WARNING, ERROR
CSAI_LOG_LEVEL=INFO
